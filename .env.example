# Copy to .env, then fill every required value with unique credentials.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Example format: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
DATABASE_URL=

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Use false only for local HTTP development; use true behind HTTPS.
COOKIE_SECURE=false
DATABASE_SSL=false
ADMIN_ID=
ADMIN_PASSWORD=
COOKIE_NAME=yt_atlas_session

WORKER_URL=http://worker:8000
# Generate with: openssl rand -hex 32
WORKER_TOKEN=
YOUTUBE_API_KEY=
# Optional until using X Posts. Set an Apify API token; it is passed only to the API.
APIFY_API_TOKEN=
MAX_VIDEOS_PER_CHANNEL=500
COLLECTION_CHANNEL_CONCURRENCY=6
# Optional: absolute host path to an age-verified YouTube session cookie export.
# Keep this file private; the worker mounts it read-only for yt-dlp.
YOUTUBE_COOKIES_PATH=

# Used by the API only; never expose this key to the browser.
# Used by the collector worker only. Create a Workers AI API token in Cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Browser requests use the same-origin Next.js API proxy by default.
NEXT_PUBLIC_API_BASE_URL=/api/v1
